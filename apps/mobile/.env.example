# Copy to .env (Expo inlines EXPO_PUBLIC_* at build time; restart Metro after a change).
# mock: everything on fixtures · hybrid: real backend where it exists, mock elsewhere · http: real everywhere
EXPO_PUBLIC_API_MODE=hybrid
# With `adb reverse tcp:3000 tcp:3000`, localhost on the phone is your computer.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLUSTER=devnet
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_PROGRAM_ID=6iXXBqsdiCnUTSVf8CW3Uuw8c7iYvZSj5haz64QMuMUh
# The SKR mint printed by `pnpm --filter @kept/api exec tsx scripts/v4-setup.ts` (STAKE_MINT).
EXPO_PUBLIC_STAKE_MINT=
EXPO_PUBLIC_APP_IDENTITY_NAME=KEPT
EXPO_PUBLIC_APP_IDENTITY_URI=https://keptdapp.vercel.app
# 86400 normally. 120 only against a program built with the debug-tools feature (2-minute days for testing).
EXPO_PUBLIC_DAY_SECONDS=86400
