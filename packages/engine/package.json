{
  "name": "@kept/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure KEPT rules: HP, miss cost, daily distribution, Rematch recovery, kept rate, odds, day boundaries",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-vectors/*": "./test-vectors/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'",
    "vectors": "tsx scripts/write-vectors.ts"
  },
  "dependencies": {
    "@kept/config": "workspace:*"
  }
}
